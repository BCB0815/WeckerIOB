package de.christian.weckersync

import android.app.*
import android.content.Intent
import android.content.pm.ServiceInfo
import android.os.Build
import android.os.IBinder
import java.util.concurrent.Executors
import java.util.concurrent.TimeUnit
import java.util.concurrent.atomic.AtomicBoolean

class SyncService : Service() {
    private val worker = Executors.newSingleThreadScheduledExecutor()
    private val main = android.os.Handler(android.os.Looper.getMainLooper())
    private val occupied = AtomicBoolean(false)
    @Volatile private var alive = false
    private lateinit var engine: SyncEngine
    override fun onBind(intent: Intent?): IBinder? = null

    override fun onCreate() {
        super.onCreate()
        val manager = getSystemService(NotificationManager::class.java)
        manager.createNotificationChannel(NotificationChannel(CHANNEL, "Wecker-Überwachung", NotificationManager.IMPORTANCE_LOW))
        if (Build.VERSION.SDK_INT >= 29) startForeground(10, notification("Verbindung wird geprüft"), ServiceInfo.FOREGROUND_SERVICE_TYPE_CONNECTED_DEVICE)
        else startForeground(10, notification("Verbindung wird geprüft"))
        try {
            val c = ConfigStore(this).load().also { it.validate() }
            val iob = IoBrokerApi(c)
            val hue = HueApi(c)
            val sonos = SonosApi(c)
            engine = SyncEngine(object : AlarmGateway {
                override fun readMaster() = iob.read()
                override fun writeMaster(value: Boolean) = iob.write(value)
                override fun syncHue(value: Boolean) = hue.reconcile(value)
                override fun syncSonos(value: Boolean) = sonos.reconcile(value)
            })
            result = SyncResult()
            alive = true
            running = true
            worker.scheduleWithFixedDelay({ executeCycle(null) }, 0, 15, TimeUnit.SECONDS)
        } catch (e: Exception) {
            result = SyncResult(iob = Network.userError(e))
            stopSelf()
        }
    }
    override fun onStartCommand(intent: Intent?, flags: Int, startId: Int): Int {
        if (intent?.action == STOP) { stopSelf(); return START_NOT_STICKY }
        if (alive && (intent?.action == SET || intent?.action == REFRESH)) {
            val requested = if (intent.action == SET && intent.hasExtra("value")) intent.getBooleanExtra("value", false) else null
            // At most one queued UI command; no unbounded queue of obsolete switch requests.
            if (!commandPending) {
                commandPending = true
                worker.execute {
                    try { executeCycle(requested) }
                    finally { commandPending = false }
                }
            }
        }
        // No silent restart / replay after force stop or reboot. User deliberately starts monitoring.
        return START_NOT_STICKY
    }
    private fun executeCycle(requested: Boolean?) {
        if (!alive || !occupied.compareAndSet(false, true)) return
        busy = true
        try {
            val next = engine.cycle(requested)
            if (!alive) return
            result = next
            main.post {
                if (alive) getSystemService(NotificationManager::class.java).notify(10,
                    notification(if (next.ok) "Hue und Sonos bestätigt: ${if (next.master == true) "AN" else "AUS"}" else "Abgleich offen · App für Details öffnen"))
            }
        } catch (_: InterruptedException) { Thread.currentThread().interrupt() }
          catch (e: Exception) { if (alive) result = SyncResult(iob = Network.userError(e), time = System.currentTimeMillis()) }
        finally { occupied.set(false); if (alive) busy = false }
    }
    private fun notification(text: String): Notification {
        val open = PendingIntent.getActivity(this, 0, Intent(this, MainActivity::class.java), PendingIntent.FLAG_IMMUTABLE or PendingIntent.FLAG_UPDATE_CURRENT)
        val stop = PendingIntent.getService(this, 1, Intent(this, SyncService::class.java).setAction(STOP), PendingIntent.FLAG_IMMUTABLE or PendingIntent.FLAG_UPDATE_CURRENT)
        return Notification.Builder(this, CHANNEL).setSmallIcon(R.drawable.ic_alarm)
            .setContentTitle("Wecker Sync").setContentText(text).setContentIntent(open)
            .setOngoing(true).setOnlyAlertOnce(true)
            .addAction(Notification.Action.Builder(null, "Überwachung stoppen", stop).build()).build()
    }
    override fun onDestroy() {
        alive = false
        running = false
        busy = false
        commandPending = false
        worker.shutdownNow()
        main.removeCallbacksAndMessages(null)
        stopForeground(STOP_FOREGROUND_REMOVE)
        super.onDestroy()
    }
    companion object {
        const val SET = "de.christian.weckersync.SET"
        const val REFRESH = "de.christian.weckersync.REFRESH"
        const val STOP = "de.christian.weckersync.STOP"
        private const val CHANNEL = "alarm-sync"
        @Volatile var running = false
            private set
        @Volatile var busy = false
            private set
        @Volatile var commandPending = false
            private set
        @Volatile var result = SyncResult()
            private set
    }
}
